# Copy this file to .env and replace every CHANGE_ME value.
# .env is ignored by Git and is also compatible with systemd EnvironmentFile.

# MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/vibelex_local_db
SPRING_DATASOURCE_USERNAME=CHANGE_ME
SPRING_DATASOURCE_PASSWORD=CHANGE_ME

# Search-capable LLM (Responses API)
VIBELEX_SEARCH_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VIBELEX_SEARCH_LLM_API_KEY=CHANGE_ME
VIBELEX_SEARCH_LLM_MODEL=doubao-seed-2-0-lite-260428
VIBELEX_SEARCH_LLM_REQUEST_TIMEOUT_SECONDS=180

# General OpenAI-compatible LLM (Chat Completions API)
VIBELEX_GENERAL_LLM_BASE_URL=CHANGE_ME
VIBELEX_GENERAL_LLM_API_KEY=CHANGE_ME
VIBELEX_GENERAL_LLM_MODEL=CHANGE_ME
VIBELEX_GENERAL_LLM_REQUEST_TIMEOUT_SECONDS=90

# Elasticsearch
VIBELEX_ES_ENABLED=true
VIBELEX_ES_URIS=http://localhost:9200/
VIBELEX_ES_INDEX_NAME=vibelex_sense_v2
VIBELEX_ES_INDEX_ALIAS=vibelex_sense_current

# Embedding service
VIBELEX_EMBEDDING_ENABLED=true
VIBELEX_EMBEDDING_ENDPOINT=CHANGE_ME
VIBELEX_EMBEDDING_MODEL_NAME=bge-large-zh
